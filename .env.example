# 飞书应用凭证（不要把真实值提交到 Git）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 例如 https://example.feishu.cn，用于生成可点击的知识库链接
FEISHU_TENANT_URL=https://feishu.cn

# “视频研究知识库”的真实资源 ID
FEISHU_WIKI_SPACE_ID=
FEISHU_WIKI_PARENT_NODE_TOKEN=
FEISHU_BASE_APP_TOKEN=
FEISHU_BASE_TABLE_ID=
# 逗号分隔；留空代表允许所有可访问该 Bot 的用户
FEISHU_ALLOWED_OPEN_IDS=

# 本地项目位置
# SHILIU_PROJECT_ROOT=  # 私有下载引擎目录（未随本仓库发行，留空即可）
VIDEO_AGENT_PROJECT_ROOT=/PATH/TO/video-agent
VIDEO_BOT_DATA_DIR=data

# 视频分析默认设置
VIDEO_AGENT_PROVIDER=openai_compatible
VIDEO_AGENT_API_KEY=
VIDEO_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_AGENT_VISION_MODEL=qwen3-vl-flash
VIDEO_AGENT_TRANSCRIPTION_PROVIDER=local_whisper
VIDEO_AGENT_LOCAL_WHISPER_MODEL=/PATH/TO/video-agent/models/ggml-large-v3-turbo.bin
VIDEO_AGENT_TRANSCRIPTION_LANGUAGE=zh
VIDEO_AGENT_TRANSCRIPTION_PROMPT="教程、收藏夹、抖音、私信、下载视频、飞书、Codex、Claude Code、AI、API。"
VIDEO_AGENT_OUTPUT_DIR=/PATH/TO/video-agent/output

# 默认使用讲解优先模式；适合教程、知识分享和口播视频
VIDEO_BOT_ANALYSIS_MODE=narration
VIDEO_BOT_QUESTION="完整理解这个视频。请提炼工具名称、时间线、关键词并指出不确定信息；answer 字段必须严格分为‘核心观点：’‘操作步骤：’‘可复用启发：’三段，三段内容必须彼此不同、各写各的（核心观点讲主张，操作步骤给有序编号的具体做法，可复用启发讲可迁移方法论），任何一段都不要复述一句话摘要，也不要三段雷同；某段确无内容就写‘无’。"

# 下载器：ytdlp（默认，需先装 yt-dlp）｜shiliu（本机私有引擎，未开源）
VIDEO_BOT_DOWNLOADER=auto
# yt-dlp 的落盘目录，留空则用 <项目>/downloads
VIDEO_BOT_DOWNLOAD_DIR=
